{
  "name": "ThemuzeProposal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run validate:env && next build --webpack",
    "start": "next start",
    "postinstall": "patch-package",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:ci": "node scripts/check-vitest-warnings.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate:env": "node scripts/validate-env.mjs",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "verify:content": "node scripts/verify-themuze-content.mjs",
    "db:status": "node scripts/db.mjs migration list",
    "db:push": "node scripts/db.mjs db push",
    "db:dump": "node scripts/db.mjs db dump --schema public --file supabase/schema.remote.sql",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/env": "16.2.12",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "isomorphic-dompurify": "2.26.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "patch-package": "^8.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "minimatch": "^3.1.5",
    "postcss": "^8.5.18",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  }
}
