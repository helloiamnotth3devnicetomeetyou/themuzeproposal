# Public canonical application URL (no trailing slash). Replace this with the
# real production domain and use the same origin in Supabase Auth Site URL and
# Redirect URLs; do not deploy the placeholder.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# Server-only key used only after session + admin + SVG sanitization checks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required by `npm run db:status` / `db:push` / `db:dump` (scripts/db.mjs) when the
# project cannot be linked via `supabase link` (e.g. CLI login is a different account
# than the project owner). From Supabase dashboard -> Project Settings -> Database ->
# Connect -> Session pooler. Percent-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Server-only HMAC secret for login rate-limit identifiers (32+ random characters)
AUTH_RATE_LIMIT_SECRET=replace-with-a-cryptographically-random-secret

# Required distinct HMAC secret for contact and report submission rate limits.
SUBMISSION_RATE_LIMIT_SECRET=replace-with-a-cryptographically-random-secret

# Header overwritten by a trusted reverse proxy with exactly one client IP.
# Required outside Vercel production. On Vercel, only set this when direct deployment
# access is blocked or the proxy is verified; for proxied Cloudflare use cf-connecting-ip.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Server-only Vercel Web Analytics API access for the admin dashboard
VERCEL_TOKEN=your-vercel-access-token
VERCEL_PROJECT_ID=prj_your-project-id
# VERCEL_TEAM_ID=team_your-team-id

# Cloudflare Turnstile CAPTCHA. Site key is public; secret key must stay server-only.
# Also configure the same key pair as the CAPTCHA provider in Supabase Auth ->
# Attack Protection, so login/signup/password verification are covered too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Cloudflare R2. Object Read & Write API token, scoped to the two buckets below.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BUCKET=themuze-public
R2_PRIVATE_BUCKET=themuze-private
# Custom domain connected to the public R2 bucket (no trailing slash).
# For direct hero-video upload, its CORS policy must allow PUT and Content-Type
# from NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.your-domain.dev

# Set to 1 on non-Vercel production CI/hosting to enforce all checks
STRICT_ENV_VALIDATION=1
