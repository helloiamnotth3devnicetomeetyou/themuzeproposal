# Public application URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://themuzeproposal.notth3.dev

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# Server-only key used only after session + admin + SVG sanitization checks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only HMAC secret for login rate-limit identifiers (32+ random characters)
AUTH_RATE_LIMIT_SECRET=replace-with-a-cryptographically-random-secret

# Required distinct HMAC secret for contact and report submission rate limits.
SUBMISSION_RATE_LIMIT_SECRET=replace-with-a-cryptographically-random-secret

# Non-Vercel production: required header overwritten by your trusted reverse proxy
# with exactly one client IP. Leave unset only for local development without a proxy.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Server-only Vercel Web Analytics API access for the admin dashboard
VERCEL_TOKEN=your-vercel-access-token
VERCEL_PROJECT_ID=prj_your-project-id
# VERCEL_TEAM_ID=team_your-team-id

# Cloudflare Turnstile CAPTCHA. Site key is public; secret key must stay server-only.
# Also configure the same key pair as the CAPTCHA provider in Supabase Auth ->
# Attack Protection, so login/signup/password verification are covered too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Set to 1 on non-Vercel production CI/hosting to enforce all checks
STRICT_ENV_VALIDATION=1
